<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="pos_config_form_admin_customer" model="ir.ui.view">
        <field name="name">pos.config.form.admin.customer</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <setting id="other_devices" position='after'>
                <setting id="default_customer_id" help="Select Admin customer">
                    <field name="default_customer_id"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>