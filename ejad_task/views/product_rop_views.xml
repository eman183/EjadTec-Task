<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_rop_tree"
            model="ir.ui.view">
        <field name="name">product.template.rop.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <tree string="Products Below ROP">
                <field name="name"/>
                <field name="default_code"/>
                <field name="qty_available"/>
                <field name="rop_count"/>
                <field name="below_rop"/>

            </tree>
        </field>
    </record>

    <record id="view_product_template_rop_kanban"
            model="ir.ui.view">
        <field name="name">product.template.rop.kanban</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="qty_available"/>
                <field name="rop_count"/>
                <field name="product_variant_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <strong>
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div>
                                Quantity:
                                <field name="qty_available"/>
                            </div>
                            <div>
                                Reorder threshold:
                                <field name="rop_count"/>
                            </div>
                            <button name="action_update_rop_quantity"
                                    string="Update Product Quantity"
                                    type="object"
                                    class="btn-primary"
                                    groups="stock.group_stock_manager,stock.group_stock_user"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_rop_products"
            model="ir.actions.act_window">
        <field name="name">ROP Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">
            [('has_rop', '=', True), ('qty_available', '&lt;', 5)]
        </field>
    </record>

    <menuitem id="menu_rop_root"
              name="Reorder Point"
              sequence="30"
              groups="stock.group_stock_manager,stock.group_stock_user"/>

    <menuitem id="menu_rop_products"
              name="ROP Products"
              parent="menu_rop_root"
              action="action_rop_products"
              sequence="10"
              groups="stock.group_stock_manager,stock.group_stock_user"/>
</odoo>