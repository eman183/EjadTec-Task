<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="website_menu_realtime_rop" model="website.menu">
        <field name="name">Real-time ROP</field>
        <field name="url">/shop/realtime-rop</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="31"/>
    </record>

    <template id="website_realtime_rop_card" name="Real-time ROP Card">
        <div class="col-6 col-md-4 col-lg-3 mb-4 o_realtime_rop_item"
             t-att-data-product-id="rop_product['id']">
            <div class="card h-100 shadow-sm">
                <a t-att-href="rop_product['website_url']">
                    <img class="card-img-top p-3"
                         style="height: 200px; object-fit: contain;"
                         t-att-src="rop_product['image_url']"
                         t-att-alt="rop_product['name']"/>
                </a>
                <div class="card-body d-flex flex-column">
                    <h6 class="card-title">
                        <a class="text-decoration-none"
                           t-att-href="rop_product['website_url']"
                           t-esc="rop_product['name']"/>
                    </h6>
                    <div class="mt-auto">
                        <span class="text-muted small">Quantity on hand</span>
                        <div class="h4 mb-1 o_realtime_rop_qty"><span t-esc="rop_product['qty_available']"/>
                            <small class="text-muted fs-6" t-esc="rop_product['uom']"/></div>
                        <span class="text-muted small o_realtime_rop_point">Reorder point: <t t-esc="rop_product['rop_count']"/></span>
                        <button type="button"
                                class="btn btn-primary btn-sm w-100 mt-2 o_realtime_rop_update"
                                t-att-data-product-id="rop_product['id']"
                                t-att-data-product-name="rop_product['name']"
                                t-att-data-qty="rop_product['qty_available']">
                            Update Product Quantity
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="website_realtime_rop_page" name="Real-time ROP">
        <t t-call="website.layout">
            <div id="wrap">
                <section class="container py-4 o_realtime_rop">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h1 class="h3 mb-1">Real-time ROP</h1>
                            <p class="text-muted mb-0">
                                Products with quantity on hand greater than 5.
                                This page updates automatically.
                            </p>
                        </div>
                        <span class="badge text-bg-success o_realtime_rop_status">
                            <i class="fa fa-circle me-1"/> Live
                        </span>
                    </div>

                    <div class="row o_realtime_rop_grid">
                        <t t-foreach="rop_products" t-as="rop_product">
                            <t t-call="ejad_task.website_realtime_rop_card"/>
                        </t>
                    </div>
                    <p t-att-class="'text-center text-muted my-5 o_realtime_rop_empty %s' % ('d-none' if rop_products else '')">
                        No products currently have more than 5 units on hand.
                    </p>

                    <div class="modal fade o_realtime_rop_modal" tabindex="-1">
                        <div class="modal-dialog">
                            <form class="modal-content o_realtime_rop_form">
                                <div class="modal-header">
                                    <h5 class="modal-title">Update Product Quantity</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" name="product_id"/>
                                    <p class="fw-bold o_realtime_rop_modal_name"/>
                                    <p class="text-muted small">
                                        Current quantity: <span class="o_realtime_rop_modal_qty"/>
                                    </p>
                                    <label class="form-label">New Quantity on Hand</label>
                                    <input type="number" name="quantity" class="form-control"
                                           min="0" step="1" required="required"/>
                                    <div class="alert alert-danger mt-3 mb-0 d-none o_realtime_rop_modal_error"/>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Apply</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>
