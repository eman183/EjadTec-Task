<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rop_update_quantity_wizard"
            model="ir.ui.view">
        <field name="name">rop.update.quantity.wizard.form</field>
        <field name="model">rop.update.quantity.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Product Quantity">
                <group>
                    <field name="product_tmpl_id"/>
                    <field name="product_id"/>
                    <field name="location_id"/>
                    <field name="quantity"/>
                </group>
                <footer>
                    <button name="action_apply_quantity"
                            string="Apply"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>